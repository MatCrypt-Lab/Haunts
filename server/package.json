{
  "name": "@unfog/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unfog API server (Fastify + PostgreSQL).",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "esbuild src/index.ts src/migrate-cli.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --packages=external --alias:@unfog/core=../packages/core/src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/migrate-cli.js",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@unfog/core": "0.1.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
