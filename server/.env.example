# Copy to server/.env for local development.
NODE_ENV=development
PORT=8080
# Bind to all interfaces so a phone on the same Wi-Fi can reach your laptop.
HOST=0.0.0.0
DATABASE_URL=postgres://localhost:5432/unfog_dev
# Set to true for managed Postgres that requires TLS (Neon, Supabase, RDS, Render).
DATABASE_SSL=false

# Development only: return the sign-in code in the API response so you can log in without email.
DEV_RETURN_OTP=true

# Production: at least 32 random characters. Generate with: openssl rand -hex 32
OTP_PEPPER=
# Email delivery for sign-in codes (https://resend.com). Without it codes are written to the log.
RESEND_API_KEY=
EMAIL_FROM=Unfog <login@yourdomain.com>

# Protects /admin endpoints (sponsor drops, challenges). At least 24 characters.
ADMIN_API_KEY=

# Fixed login for App Store and Play Store reviewers. Both or neither.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=

# Set false to run migrations separately (npm run migrate:prod).
MIGRATE_ON_START=true
LOG_LEVEL=info
