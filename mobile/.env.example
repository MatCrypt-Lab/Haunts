# Copy to mobile/.env. Expo inlines EXPO_PUBLIC_* values at build time.
# Use your laptop's LAN IP (not localhost) when testing on a physical phone.
# Android emulator: http://10.0.2.2:8080   iOS simulator: http://localhost:8080
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Optional: a different MapLibre style. The default is OpenFreeMap's dark style (free, no key).
EXPO_PUBLIC_MAP_STYLE_URL=

# Change before publishing: must be unique on the App Store and Play Store.
APP_BUNDLE_ID=app.unfog.mobile
